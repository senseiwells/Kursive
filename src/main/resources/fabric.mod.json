{
  "schemaVersion": 1,
  "id": "kursive",
  "version": "${version}",
  "name": "Kursive",
  "description": "",
  "authors": [
    "Sensei"
  ],
  "contact": {

  },
  "license": "MIT",
  "icon": "assets/kursive/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.senseiwells.kursive.client.KursiveClient"
      }
    ],
    "main": [
      {
        "adapter": "kotlin",
        "value": "me.senseiwells.kursive.common.Kursive"
      },
      {
        "adapter": "kotlin",
        "value": "me.senseiwells.kursive.server.KursiveServer"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "me.senseiwells.kursive.client.compat.ModMenuKursiveImpl"
      }
    ]
  },
  "mixins": [
    "kursive.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "fabricloader": ">=${fabric_loader_dependency}",
    "yet_another_config_lib_v3": ">=${yacl_dependency}",
    "minecraft": "${minecraft_dependency}"
  }
}
